{
  "name": "@gojsop/testing",
  "version": "0.0.0",
  "description": "Test gojsop hooks and policies with vitest. The script runs in gojsop's engine, never in Node.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efuturetoday/gojsop.git",
    "directory": "sdk/testing"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gojsop/cli": "0.0.0",
    "source-map-js": "^1.2.1"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
